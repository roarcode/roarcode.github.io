    The inline min-height below reserves space so enabling ads never shifts layout. -#}
{%- if site.ads.enabled -%}
<aside class="ad-slot" style="display:grid;place-items:center;min-height:250px;margin-block:2rem;color:#8a80a8;font:12px/1 monospace" data-ad-slot="{{ slot or 'default' }}" data-pagefind-ignore aria-label="Advertisement">
