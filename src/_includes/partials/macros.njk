{#- Reusable components. Class names are the contract with the Designer kit (preview.html). -#}

{% macro badge(text, kind) -%}
<span class="badge{% if kind %} badge--{{ kind }}{% endif %}">{{ text }}</span>
{%- endmacro %}

{#- Spoiler level badge: green "Spoiler-free", amber "Minor spoilers", red "Major spoilers". -#}
{% macro spoilerBadge(level, label, extra) -%}
<span class="badge badge--spoiler badge--spoiler-{{ level }}{% if extra %} {{ extra }}{% endif %}" title="Spoiler level: {{ label }}">{{ label }}</span>
{%- endmacro %}

{% macro guideCard(g, showCategory) -%}
<article class="guide-card" style="--accent: var({{ g.category.accentVar }}, var(--x-accent-default))">
  <a class="guide-card__link" href="{{ g.url | url }}">
    <div class="guide-card__top">
      {{ spoilerBadge(g.spoilers, g.spoilerLabel, "guide-card__badge") }}
      {%- if showCategory %}<span class="guide-card__badge badge badge--category">{{ g.category.short }}</span>{% endif %}
      {%- if g.rumour %}<span class="guide-card__badge badge badge--rumour">Rumour</span>{% endif %}
      {%- if g.placeholder %}<span class="guide-card__badge badge badge--placeholder">Placeholder</span>{% endif %}
    </div>
    <h3 class="guide-card__title">{{ g.title }}</h3>
    <p class="guide-card__desc">{{ g.description }}</p>
    <p class="guide-card__meta"><span>Updated <time datetime="{{ g.updatedDate }}">{{ g.updatedLabel }}</time></span><span aria-hidden="true">·</span><span>{{ g.readingMinutes }} min read</span></p>
  </a>
</article>
{%- endmacro %}

{% macro categoryCard(c) -%}
<article class="category-card" style="--accent: var({{ c.accentVar }}, var(--x-accent-default))">
  <a class="category-card__link" href="{{ c.url | url }}">
    {%- if c.img %}<span class="category-card__media" aria-hidden="true"><picture><source type="image/avif" srcset="{{ ('/assets/img/' + c.img + '-640.avif') | url }}"><img src="{{ ('/assets/img/' + c.img + '-640.webp') | url }}" alt="" width="640" height="360" loading="lazy" decoding="async"></picture></span>{% endif %}
    <span class="category-card__kicker">{{ c.count }} {{ 'guide' if c.count == 1 else 'guides' }}</span>
    <h3 class="category-card__title">{{ c.name }}</h3>
    <p class="category-card__desc">{{ c.description }}</p>
    <span class="category-card__cta" aria-hidden="true">Browse →</span>
  </a>
</article>
{%- endmacro %}

{% macro breadcrumbs(items) -%}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    {%- for c in items %}
    <li class="breadcrumbs__item">
      {%- if loop.last %}<span aria-current="page">{{ c.name }}</span>
      {%- else %}<a href="{{ c.url | url }}">{{ c.name }}</a>{% endif -%}
    </li>
    {%- endfor %}
  </ol>
</nav>
{%- endmacro %}
