{#- Redesign v2 header (design/components.css §2): slim nav, ONE pill CTA, search dropdown, spoiler switch. -#}
{%- set nameParts = site.name.split(' ') -%}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="{{ '/' | url }}" aria-label="{{ site.name }} — home">
      {%- if assets.logoIcon %}<img class="site-header__logo" src="{{ assets.logoIcon | url }}" width="30" height="30" alt="">{% endif %}
      <span class="site-header__wordmark" aria-hidden="true">{{ nameParts[0] }}{% if nameParts.length > 1 %} <span>{{ nameParts.slice(1).join(' ') }}</span>{% endif %}</span>
    </a>
    <nav class="nav" id="site-nav" aria-label="Guide categories">
      <ul class="nav__list">
        {%- for c in library.navCategories %}
        <li><a class="nav__link {{ c.catClass }}" href="{{ c.url | url }}"{% if (pageType == 'category' and item.slug == c.slug) or (pageType == 'guide' and item.categorySlug == c.slug) %} aria-current="page"{% endif %}>{{ c.short }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="site-header__actions">
      {#- Page-level spoiler switch. Needs JS (hidden by <noscript> in <head>); without JS every spoiler is still click-to-reveal. -#}
      <button class="spoiler-toggle" type="button" role="switch" aria-checked="false" title="Show all spoilers" data-spoiler-toggle><span class="spoiler-toggle__track" aria-hidden="true"></span><span class="spoiler-toggle__label">Show all spoilers</span><span class="spoiler-toggle__state" data-spoiler-state>Off</span></button>
      <button class="icon-btn site-header__search-toggle" type="button" aria-label="Search" aria-expanded="false" aria-controls="site-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <a class="btn btn--cta btn--sm site-header__cta" href="{{ '/launch-hub/release-time/' | url }}">Unlock time</a>
      <button class="icon-btn site-header__toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span class="icon-btn__open"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span><span class="icon-btn__close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></span></button>
    </div>
    {#- Plain GET form to /search/?q=… (works with no JS); the search page boots Pagefind UI. -#}
    <div class="site-header__search search" id="site-search" role="search">
      <form class="search__form" action="{{ '/search/' | url }}" method="get">
        <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input class="search__input" id="site-search-q" type="search" name="q" placeholder="Search guides…" aria-label="Search guides" autocomplete="off" enterkeyhint="search">
      </form>
    </div>
  </div>
</header>
