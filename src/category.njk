---
layout: layouts/base.njk
pageType: category
pagination:
  data: library.categories
  size: 1
  alias: item
permalink: "{{ item.path }}/index.html"
eleventyExcludeFromCollections: true
---
{% from "partials/macros.njk" import guideCard, breadcrumbs %}
<div class="container" style="--accent: var({{ item.accentVar }}, var(--x-accent-default))">
  {{ breadcrumbs(item | crumbs(pageType)) }}
  <header class="page-header">
    <p class="page-header__kicker">Category</p>
    <h1 class="page-header__title">{{ item.name }}</h1>
    {%- if item.intro or item.description %}<p class="page-header__lead">{{ item.intro or item.description }}</p>{% endif %}
    <p class="page-header__meta">
      {{ item.count }} {{ 'guide' if item.count == 1 else 'guides' }}
      {%- if item.lastUpdated %} · Last updated <time datetime="{{ item.lastUpdatedDate }}">{{ item.lastUpdatedLabel }}</time>{% endif %}
    </p>
  </header>

  {%- if item.guides.length %}
  {#- Newest first (library sorts by updated). On the Launch Hub the freshest pages get their own labelled block. -#}
  {%- if item.slug == 'launch-hub' and item.guides.length > 3 %}
  <section class="section" aria-labelledby="latest-h">
    <header class="section__header">
      <h2 class="section__title" id="latest-h">Latest updates</h2>
      <p class="section__meta">Newest first · last updated <time datetime="{{ item.lastUpdatedDate }}">{{ item.lastUpdatedLabel }}</time></p>
    </header>
    <ol class="update-list">
      {%- for g in item.guides | slice(0, 6) %}{% for x in g %}
      <li class="update-list__item"><a class="update-list__link" href="{{ x.url | url }}">{{ x.title }}</a> <time class="update-list__time" datetime="{{ x.updatedValue }}">{{ x.updatedLabel }}</time></li>
      {%- endfor %}{% endfor %}
    </ol>
  </section>
  {%- endif %}
  <h2 class="visually-hidden" id="guides-h">{{ 'All launch guides' if item.slug == 'launch-hub' else 'Guides in ' + item.name }}</h2>
  <div class="grid grid--cards section">
    {%- for g in item.guides %}{{ guideCard(g, false) }}{% endfor %}
  </div>
  {%- else %}
  <div class="empty section">
    <p class="empty__title">No guides here yet.</p>
    <p>We publish as soon as there is something verified to say. <a href="{{ '/' | url }}">Browse all categories</a> or <a href="{{ '/search/' | url }}">search</a>.</p>
  </div>
  {%- endif %}

  {%- set slot = "category-end" %}{% include "partials/ad-slot.njk" %}
  <nav class="section hub-links" aria-labelledby="hubs-h">
    <h2 class="section__title" id="hubs-h">Explore other hubs</h2>
    <ul class="hub-links__list">
      {%- for c in library.navCategories %}{% if c.slug != item.slug %}
      <li><a class="hub-links__link" href="{{ c.url | url }}" style="--accent: var({{ c.accentVar }}, var(--x-accent-default))">{{ c.name }}{% if c.count %} <span>({{ c.count }})</span>{% endif %}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </nav>
</div>
