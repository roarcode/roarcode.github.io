{
  "name": "gta6-guides",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial GTA VI English guides fan site: Eleventy static site generator + Pagefind search.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf _site",
    "build:site": "eleventy",
    "build": "npm run clean && npm run build:site && npm run index:search",
    "dev": "eleventy --serve --quiet",
    "watch": "node scripts/watch.mjs",
    "preview": "node scripts/preview.mjs",
    "start": "npm run build && npm run preview",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify-output.mjs",
    "index:search": "pagefind --site _site --force-language en --quiet"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "lightningcss": "^1.30.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "pagefind": "^1.4.0",
    "sharp": "^0.35.5"
  }
}
